# eFinder configuration file
# Location: /home/efinder/Solver/eFinder.config
# Lines beginning with # are comments and are ignored.
# Format: key:value  (no spaces around the colon)
#
# After editing, restart eFinder:
#   sudo systemctl restart efinder

# ---------------------------------------------------------------------------
# Camera settings
# ---------------------------------------------------------------------------
Exposure:0.5
Gain:10

# ---------------------------------------------------------------------------
# Finder scope optical axis offset from main scope (arcminutes)
# Set by the Calibration wizard at http://192.168.50.1/calibrate.php
# ---------------------------------------------------------------------------
d_x:0
d_y:0

# ---------------------------------------------------------------------------
# Mount integration (optional)
#
# mount_mode options:
#   none   — No mount connected. SkySafari connects to this device on
#             port 4060 and receives the solved RA/Dec directly.
#             This is the default — remove or comment out mount_* lines
#             to use this mode.
#
#   wifi   — OnStepX mount with built-in WiFi (e.g. FYSETC E4).
#             Pi connects to the mount on mount_port (9999) and sends a
#             sync command after every successful plate solve.
#             SkySafari should connect to the mount's IP on port 9998.
#             The Pi's LX200 server on port 4060 stays running as fallback.
#
#   serial — Any LX200-compatible mount connected via serial/UART.
#             Pi connects to mount_serial and sends a sync command after
#             every successful plate solve.
#             SkySafari connects to this device on port 4060 as today.
#
# Uncomment and edit ONE of the three blocks below:
# ---------------------------------------------------------------------------

# --- Scenario A: no mount (default) ---
mount_mode:none

# --- Scenario B: OnStepX / FYSETC E4 via WiFi ---
# Switch to E4's network first:  ~/station.sh OnStepX password
# Configure SkySafari: Meade LX200 Classic, IP=192.168.0.1, port=9998
#mount_mode:wifi
#mount_host:192.168.0.1
#mount_port:9999

# --- Scenario C: serial mount via GPIO UART ---
# Requires hardware UART enabled and USB gadget disabled in config.txt
#mount_mode:serial
#mount_serial:/dev/ttyAMA0
#mount_baud:9600
